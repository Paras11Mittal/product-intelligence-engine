# Research providers (set the providers used by your deployment)
SERPER_API_KEY=
TAVILY_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Supabase browser auth and persistence
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Comma-separated exact frontend origins. Include scheme; omit trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000
# Optional regex for preview deployments. Leave blank unless needed.
CORS_ALLOWED_ORIGIN_REGEX=
